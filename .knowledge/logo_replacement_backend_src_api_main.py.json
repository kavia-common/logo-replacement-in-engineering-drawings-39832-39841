{"is_source_file": true, "format": "Python", "description": "This file implements a REST API backend for a logo replacement service targeting engineering drawings. It provides endpoints for creating jobs, uploading ZIP files and logos, starting background processing, polling job status, downloading processed results, and deleting jobs. The API is built using FastAPI and manages job lifecycle and storage through service classes and in-memory/external storage.", "external_files": ["src/models/schemas.py", "src/services/job_store.py", "src/services/processing.py"], "external_methods": ["JobStore.create_job", "JobStore.get_status", "JobStore.save_uploads", "JobStore.update_status", "JobStore.get_uploads_dir", "JobStore.get_result_dir", "JobStore.cleanup", "process_job_pipeline"], "published": ["create_job", "upload_files", "start_processing", "get_status", "download_result", "delete_job"], "classes": [{"name": "ErrorResponse", "description": "Pydantic model for error response with a 'detail' message."}], "methods": [{"name": "health_check()", "description": "Health check endpoint returning service status.", "scope": "", "scopeKind": ""}, {"name": "JobCreated create_job()", "description": "Creates a new processing job with initial PENDING status.", "scope": "", "scopeKind": ""}, {"name": "JobStatus upload_files( job_id: str, drawings: UploadFile = File(..., description=\"ZIP file containing drawing images\"), logo: UploadFile = File(..., description=\"Logo image to overlay\"), )", "description": "Uploads ZIP drawings and logo image, saves and extracts them into the job storage.", "scope": "", "scopeKind": ""}, {"name": "JobStatus start_processing(job_id: str)", "description": "Starts background processing of the uploaded drawings.", "scope": "", "scopeKind": ""}, {"name": "JobStatus get_status(job_id: str)", "description": "Returns current status and details of the specified job.", "scope": "", "scopeKind": ""}, {"name": "download_result(job_id: str)", "description": "St